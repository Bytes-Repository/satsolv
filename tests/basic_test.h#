;; ── pool: porównanie wersji (przez Id, jak dotychczas) ───────────────────
#[test]
fn test_pool_evrcmp() is
    let p: int = lib::pool::create()
    let v1: i32 = lib::pool::str2id(p, "1.0-1", true)
    let v2: i32 = lib::pool::str2id(p, "2.0-1", true)
    let cmp: i32 = lib::pool::evrcmp(p, v1, v2)
    assert(cmp < 0)
    lib::pool::free(p)
end

;; ── pool: porównanie wersji na gołych stringach (bez internowania) ───────
#[test]
fn test_pool_evrcmp_str() is
    let p: int = lib::pool::create()
    assert(lib::pool::evrcmp_str(p, "1.0-1", "2.0-1") < 0)
    assert(lib::pool::evrcmp_str(p, "2.0-1", "2.0-1") == 0)
    assert(lib::pool::evrcmp_str(p, "3.0-1", "2.0-1") > 0)
    lib::pool::free(p)
end

