;; ── pełny scenariusz: repo "z palca" + install job + solve + transakcja ──
#[test]
fn test_full_install_scenario() is
    let p: int = lib::pool::create()
    lib::pool::set_arch(p, "x86_64")

    let system: int = lib::repo::create(p, "system")
    lib::pool::set_installed(p, system)
    lib::repo::internalize(system)

    let available: int = lib::repo::create(p, "available")
    lib::repo::set_priority(available, 10, 0)

    let foo: lib::repo::Pkg = lib::repo::new_pkg("foo", "1.0", "1", "x86_64")
    let mut bar: lib::repo::Pkg = lib::repo::new_pkg("bar", "2.0", "1", "x86_64")
    bar.requires = ["foo"]

    match lib::repo::add_packages(p, available, [foo, bar]) is
        lib::SatResult::Ok(rc) => is end
        lib::SatResult::Err(msg) => is
            assert(false)
        end
    end
    lib::repo::internalize(available)

    lib::pool::createwhatprovides(p)

    let jobs: int = lib::queue::new()
    lib::job::install_name(jobs, p, "bar")

    let s: int = lib::solver::create(p)
    lib::solver::allow_downgrade(s, false)
    let problems: i32 = lib::solver::solve(s, jobs)
    assert_eq(problems, 0)

    let t: int = lib::transaction::create_from_solver(s)
    let installed: [i32] = lib::transaction::installed_result(t)
    ;; "foo" i "bar" powinny obie trafić na listę do instalacji
    assert(array_len(installed) >= 2)

    ;; classify() powinno zwrócić przynajmniej jedną klasę kroków
    ;; (rekordy po 4 pola: type_id/count/from_id/to_id, patrz mod transaction)
    let classes: [lib::transaction::TransactionClass] = lib::transaction::classify_active(t)
    assert(array_len(classes) >= 1)

    lib::transaction::free(t)
    lib::queue::free(jobs)
    lib::solver::free(s)
    lib::repo::free(available, false)
    lib::repo::free(system, false)
    lib::pool::free(p)
end
