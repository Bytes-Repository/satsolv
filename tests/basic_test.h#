use "std -> test" from "test"
mod lib

;; ── queue: własna implementacja push/get/count na strukturze Queue ──────
#[test]
fn test_queue_push_and_count() is
    let q: int = lib::queue::new()
    assert_eq(lib::queue::count(q), 0)

    lib::queue::push(q, 10)
    lib::queue::push(q, 20)
    lib::queue::push(q, 30)

    assert_eq(lib::queue::count(q), 3)
    assert_eq(lib::queue::get(q, 0), 10)
    assert_eq(lib::queue::get(q, 1), 20)
    assert_eq(lib::queue::get(q, 2), 30)

    lib::queue::free(q)
end

#[test]
fn test_queue_push2_and_to_array() is
    let q: int = lib::queue::new()
    lib::queue::push2(q, 1, 2)
    lib::queue::push2(q, 3, 4)

    let arr: [i32] = lib::queue::to_array(q)
    assert_eq(array_len(arr), 4)
    assert_eq(arr[0], 1)
    assert_eq(arr[3], 4)

    lib::queue::free(q)
end

;; Odtworzenie sekwencji "queue_alloc_one" wielokrotnie — sprawdza, że
;; rozrost bufora (prawdziwy kod libsolv) działa poprawnie przy wielu
;; kolejnych push().
#[test]
fn test_queue_grows_past_initial_capacity() is
    let q: int = lib::queue::new()
    let mut i: i32 = 0
    while i < 500 is
        lib::queue::push(q, i)
        i += 1
    end
    assert_eq(lib::queue::count(q), 500)
    assert_eq(lib::queue::get(q, 499), 499)
    lib::queue::free(q)
end

