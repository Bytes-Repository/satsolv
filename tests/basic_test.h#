;; ── repo::add_packages: walidacja odrzuca próbę wstrzyknięcia linii ──────
;; Pakiet z "\n#>=Pkg: zly 1 1 x86_64" w nazwie wersji NIE powinien nigdy
;; trafić do testcase_add_testtags — walidacja musi go odrzucić wcześniej.
#[test]
fn test_add_packages_rejects_newline_injection() is
    let p: int = lib::pool::create()
    let r: int = lib::repo::create(p, "available")

    let evil: lib::repo::Pkg = lib::repo::new_pkg(
        "foo", "1.0\n#>=Pkg: zly 9.9 1 x86_64", "1", "x86_64"
    )

    match lib::repo::add_packages(p, r, [evil]) is
        lib::SatResult::Ok(rc) => is
            assert(false)  ;; nie powinno się udać
        end
        lib::SatResult::Err(msg) => is
            assert(msg != "")
        end
    end

    lib::repo::free(r, false)
    lib::pool::free(p)
end

